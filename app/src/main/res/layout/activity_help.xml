<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="Help" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Logging Your Mood -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logging Your Mood"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap any cell on the calendar to log how you are feeling at that moment. A dialog will appear where you can pick a color from your legend, optionally write a note about what is going on, and then tap Save. The cell fills with the color you chose — that is your mood pixel.\n\nTap a cell that already has a color to edit or delete that entry."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />

            <!-- Calendar Views -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendar Views"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use the tabs at the top of the screen to switch how you see your data:\n\n• Day — 24 hourly slots for a single day. Great for detailed tracking.\n\n• 3-Day — three days side by side, useful for spotting short patterns.\n\n• Week — all seven days of the week in one view.\n\n• Month — one pixel per day for the whole month. You can tap any day to jump into the Day view for that date.\n\n• Year — the full year with each day as a small pixel. Tap any month to jump to the Month view."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />

            <!-- Navigating Dates -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Navigating Dates"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use the left and right arrows below the tabs to move backward or forward in time. The step size matches your current view — one day at a time in Day view, one week in Week view, and so on.\n\nTap the Today button to jump straight back to the current date."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />

            <!-- Your Legend -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Legend"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your legend is the set of colors and mood names you created when you first set up the app. Each color represents a mood — for example, blue might mean Calm, red might mean Stressed, and green might mean Happy.\n\nYou can add, remove, or rename moods at any time by opening the menu and tapping Edit Legend. Changes to names take effect going forward; colors already logged on the calendar will keep their original color."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />

            <!-- Scheduled Questions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scheduled Questions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scheduled questions let you build a daily or weekly check-in routine. Each question sends a notification at the time you set. When you tap the notification, you are taken directly to an answer screen.\n\nQuestions can have three answer types:\n\n• Yes / No — a simple two-option toggle.\n\n• Number — enter any numeric value, useful for tracking things like sleep hours, pain levels, or glasses of water.\n\n• Text — a free-form text answer for anything else.\n\nYou can schedule a question to fire every day or only on specific days of the week. Toggle questions on or off at any time without losing your past answers.\n\nAll answers are saved and appear in Reports grouped by the day they were answered."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />

            <!-- Reports -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reports shows a chronological log of everything you have tracked, grouped by date with the most recent day at the top.\n\nEach mood entry shows the color swatch, mood name, time of day, and any note you wrote when logging it. Scheduled question answers appear below the mood entries for each day, showing the question, your answer, and the time you answered.\n\nTap the share icon in the top-right corner of the Reports screen to export your data and send it via any app on your device — email, messages, cloud storage, and more."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />

            <!-- Manage / Share Data -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage / Share Data"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export and Share — saves all your mood entries, legend, scheduled questions, and answers into a single JSON file. You can share it to any app, save it to a file, or send it to yourself as a backup.\n\nImport — restores data from a previously exported JSON file. Existing entries are kept; only new data from the file is added.\n\nDelete All Data — permanently removes all mood entries and question answers. This cannot be undone. Your legend and question definitions are kept."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="20dp" />

            <!-- Settings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theme — choose Light, Dark, or System to follow your device setting.\n\nDaily view text size — controls how large the mood name text appears inside each hour slot in the Day, 3-Day, and Week views.\n\nWeek starts on — choose whether your weeks begin on Monday or Sunday. This affects how the Week and Month views are arranged."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
